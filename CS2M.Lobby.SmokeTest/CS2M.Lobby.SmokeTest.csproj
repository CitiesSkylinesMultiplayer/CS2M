<Project Sdk="Microsoft.NET.Sdk">

    <!-- Plays a host and a joiner against a running lobby server, serializing exactly like the mod does
         (same MessagePack, MessagePack.Attributeless and LiteNetLib versions as CS2M/CS2M.csproj). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>NU1902;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="1.3.1"/>
        <PackageReference Include="MessagePack" Version="3.1.3"/>
        <PackageReference Include="MessagePack.Attributeless" Version="1.0.1"/>
    </ItemGroup>

</Project>
