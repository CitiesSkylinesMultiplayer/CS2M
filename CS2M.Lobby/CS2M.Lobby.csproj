<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>CS2M.Lobby</AssemblyName>
        <RootNamespace>CS2M.Lobby</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Same LiteNetLib as the mod (CS2M/CS2M.csproj): its packet and NAT punch formats must match -->
        <PackageReference Include="LiteNetLib" Version="1.3.1"/>
        <!-- Only the low-level MessagePack reader and writer are used, whose format is the MessagePack spec,
             so this can be newer than the mod's 3.1.3. 3.1.7+ fixes unbounded recursion in Skip() on untrusted input. -->
        <PackageReference Include="MessagePack" Version="3.1.12"/>
    </ItemGroup>

</Project>
